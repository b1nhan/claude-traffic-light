{
  "name": "claude-traffic-light-desktop",
  "version": "1.1.0",
  "description": "Cửa sổ always-on-top + system tray hiển thị trạng thái Claude Code (đỏ/vàng/xanh)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.2.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vuicoding.claudetrafficlight",
    "productName": "Claude Traffic Light",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/green-256.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/green-1024.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "afterSign": "scripts/notarize.js",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "assets/green-256.png",
      "category": "Development",
      "synopsis": "Đèn giao thông hiển thị trạng thái Claude Code"
    },
    "extraResources": [
      {
        "from": "assets/connect-claude.ps1",
        "to": "connect-claude.ps1"
      },
      {
        "from": "assets/connect-claude.sh",
        "to": "connect-claude.sh"
      }
    ]
  },
  "author": {
    "name": "b1nhan",
    "email": "sukiakira1411@gmail.com"
  },
  "homepage": "https://github.com/b1nhan/claude-traffic-light"
}
