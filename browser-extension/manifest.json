{
  "manifest_version": 3,
  "name": "Claude Traffic Light",
  "version": "1.0.0",
  "description": "Hiển thị trạng thái Claude Code (đang chạy / chờ xác nhận / đã xong) trên icon trình duyệt",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/gray-16.png",
      "48": "icons/gray-48.png",
      "128": "icons/gray-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://localhost:7317/*"],
  "icons": {
    "16": "icons/gray-16.png",
    "48": "icons/gray-48.png",
    "128": "icons/gray-128.png"
  }
}
