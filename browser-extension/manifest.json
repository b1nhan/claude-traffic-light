{
  "manifest_version": 3,
  "name": "Claude Traffic Light",
  "version": "1.0.0",
  "description": "Hiển thị trạng thái claude.ai (đang trả lời / chờ xác nhận / đã xong) trên icon trình duyệt — không cần server local",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/gray-16.png",
      "48": "icons/gray-48.png",
      "128": "icons/gray-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content-claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/gray-16.png",
    "48": "icons/gray-48.png",
    "128": "icons/gray-128.png"
  }
}
